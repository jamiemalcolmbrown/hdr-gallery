[Unit]
Description=Image Gallery v0.4
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/jamie/image-gallery
Environment=FLASK_APP=app.py
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jamie/image-gallery/.venv/bin/flask run --host=0.0.0.0 --port=5000
Restart=always
RestartSec=2
User=jamie

[Install]
WantedBy=multi-user.target
