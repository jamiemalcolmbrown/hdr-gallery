[Unit]
Description=Image Gallery v0.3.0
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/image-gallery
Environment=FLASK_APP=app.py
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/image-gallery/.venv/bin/flask run --host=0.0.0.0 --port=5000
Restart=always
RestartSec=2
User=%i

[Install]
WantedBy=multi-user.target
